{
  "name": "participant registry",
  "metadata": {
    "comment": "GET /participants - the registry that maps the consumer DID from the token to the self-description URL a contract names its parties by."
  },
  "request": {
    "method": "GET",
    "url": "/v1/participants"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": [
      {
        "did": "did:key:zDevConsumer",
        "selfDescriptionURL": "http://mock:8080/participants/dev-consumer"
      }
    ]
  }
}
